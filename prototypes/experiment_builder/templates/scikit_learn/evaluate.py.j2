"""Evaluate saved pipelines on the independent test split."""

from __future__ import annotations

import json
from pathlib import Path

import joblib
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import yaml
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    f1_score,
    mean_absolute_error,
    mean_squared_error,
    precision_score,
    r2_score,
    recall_score,
    roc_auc_score,
    roc_curve,
)
from sklearn.metrics import ConfusionMatrixDisplay

ROOT = Path(__file__).resolve().parent


def main() -> None:
    config = yaml.safe_load((ROOT / "experiment.yaml").read_text(encoding="utf-8"))
    data = pd.read_csv(ROOT / "data" / "dataset.csv")
    split = json.loads((ROOT / "outputs" / "reports" / "split.json").read_text(encoding="utf-8"))
    test_frame = data.iloc[split["test_indices"]]
    y_test = test_frame[config["target"]]
    figure_directory = ROOT / "outputs" / "figures"
    metrics_directory = ROOT / "outputs" / "metrics"
    report_directory = ROOT / "outputs" / "reports"
    for directory in (figure_directory, metrics_directory, report_directory):
        directory.mkdir(parents=True, exist_ok=True)

    for model_config in config["models"]:
        name = model_config["name"]
        pipeline = joblib.load(ROOT / "outputs" / "models" / f"{name}.joblib")
        predictions = pipeline.predict(test_frame[config["features"]])
        scores: dict[str, float] = {}
        if config["task"] == "regression":
            available = {
                "mae": mean_absolute_error(y_test, predictions),
                "rmse": float(np.sqrt(mean_squared_error(y_test, predictions))),
                "r2": r2_score(y_test, predictions),
            }
            scores = {key: float(available[key]) for key in config["metrics"]}
            if "predicted_vs_actual" in config["visualizations"]:
                fig, axis = plt.subplots()
                axis.scatter(y_test, predictions, alpha=0.75)
                bounds = [min(y_test.min(), predictions.min()), max(y_test.max(), predictions.max())]
                axis.plot(bounds, bounds, color="black", linestyle="--")
                axis.set(xlabel="Actual", ylabel="Predicted", title=f"{name}: predicted vs actual")
                fig.savefig(figure_directory / f"{name}_predicted_vs_actual.png", bbox_inches="tight")
                plt.close(fig)
            if "residuals" in config["visualizations"]:
                fig, axis = plt.subplots()
                axis.hist(np.asarray(y_test) - np.asarray(predictions), bins="auto")
                axis.set(xlabel="Residual", ylabel="Count", title=f"{name}: residual distribution")
                fig.savefig(figure_directory / f"{name}_residuals.png", bbox_inches="tight")
                plt.close(fig)
        else:
            average = "weighted"
            available = {
                "accuracy": accuracy_score(y_test, predictions),
                "precision": precision_score(y_test, predictions, average=average, zero_division=0),
                "recall": recall_score(y_test, predictions, average=average, zero_division=0),
                "f1": f1_score(y_test, predictions, average=average, zero_division=0),
            }
            if "roc_auc" in config["metrics"]:
                if y_test.nunique() != 2 or not hasattr(pipeline, "predict_proba"):
                    raise ValueError("ROC AUC requires a binary target and predict_proba support")
                positive_class = pipeline.classes_[1]
                positive_scores = pipeline.predict_proba(test_frame[config["features"]])[:, 1]
                available["roc_auc"] = roc_auc_score(y_test == positive_class, positive_scores)
            scores = {key: float(available[key]) for key in config["metrics"]}
            report = classification_report(y_test, predictions, output_dict=True, zero_division=0)
            (report_directory / f"{name}_classification_report.json").write_text(
                json.dumps(report, indent=2), encoding="utf-8"
            )
            if "confusion_matrix" in config["visualizations"]:
                display = ConfusionMatrixDisplay.from_predictions(y_test, predictions, xticks_rotation="vertical")
                display.figure_.savefig(figure_directory / f"{name}_confusion_matrix.png", bbox_inches="tight")
                plt.close(display.figure_)
            if "roc_curve" in config["visualizations"]:
                positive_class = pipeline.classes_[1]
                positive_scores = pipeline.predict_proba(test_frame[config["features"]])[:, 1]
                false_positive_rate, true_positive_rate, _ = roc_curve(y_test == positive_class, positive_scores)
                fig, axis = plt.subplots()
                axis.plot(false_positive_rate, true_positive_rate)
                axis.plot([0, 1], [0, 1], color="black", linestyle="--")
                axis.set(xlabel="False positive rate", ylabel="True positive rate", title=f"{name}: ROC curve")
                fig.savefig(figure_directory / f"{name}_roc_curve.png", bbox_inches="tight")
                plt.close(fig)

        (metrics_directory / f"{name}.json").write_text(json.dumps(scores, indent=2), encoding="utf-8")
        print(f"{name}: {scores}")


if __name__ == "__main__":
    main()